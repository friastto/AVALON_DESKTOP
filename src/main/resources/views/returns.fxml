<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.*?>

<VBox spacing="20.0" styleClass="dashboard-container" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.avalon.desktop.ui.presentation.controller.ReturnController">
   <children>
      <VBox>
         <children>
            <Label styleClass="title-label" text="GESTIÓN DE DEVOLUCIONES" />
            <Label styleClass="subtitle-label" text="Registrar y consultar devoluciones de ventas" />
         </children>
      </VBox>

      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <TextField fx:id="searchSaleField" prefWidth="300.0" promptText="Buscar venta por ID..." />
            <Button onAction="#searchSale" styleClass="button-primary" text="BUSCAR VENTA">
               <graphic>
                  <FontIcon iconLiteral="mdi2m-magnify" iconColor="#0A0A0A" iconSize="20" />
               </graphic>
            </Button>
         </children>
      </HBox>

      <Label fx:id="lblSaleInfo" style="-fx-text-fill: white;" text="Información de la venta seleccionada aparecerá aquí." />

      <TableView fx:id="saleItemsTable" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colProductId" prefWidth="75.0" text="ID" />
          <TableColumn fx:id="colProductName" prefWidth="200.0" text="PRODUCTO" />
          <TableColumn fx:id="colProductQty" prefWidth="100.0" text="CANT. VENDIDA" />
          <TableColumn fx:id="colProductPrice" prefWidth="100.0" text="PRECIO" />
          <TableColumn fx:id="colReturnQty" prefWidth="100.0" text="CANT. A DEVOLVER" />
          <TableColumn fx:id="colReturnType" prefWidth="150.0" text="TIPO DEVOLUCIÓN" />
          <TableColumn fx:id="colReturnReason" prefWidth="200.0" text="MOTIVO" />
        </columns>
          <columnResizePolicy>
              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
          </columnResizePolicy>
      </TableView>

      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button onAction="#registerReturn" styleClass="button-primary" text="REGISTRAR DEVOLUCIÓN">
               <graphic>
                  <FontIcon iconLiteral="mdi2r-receipt" iconColor="#0A0A0A" iconSize="20" />
               </graphic>
            </Button>
         </children>
      </HBox>
   </children>
</VBox>
