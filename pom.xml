<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.avalon</groupId>
    <artifactId>AvalonDesktop</artifactId>
    <version>1.0.1</version>
    <name>AvalonDesktop</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <javafx.version>21.0.2</javafx.version>
        <guice.version>7.0.0</guice.version>
        <sqlite.version>3.45.1.0</sqlite.version>
        <slf4j.version>2.0.12</slf4j.version> <!-- CORREGIDO: slf44j.version a slf4j.version -->
        <logback.version>1.5.0</logback.version>
        <jackson.version>2.17.0</jackson.version>

        <!-- Propiedades para jlink y jpackage -->
        <jlink.image.name>AvalonDesktopApp</jlink.image.name>
        <jpackage.app.name>AvalonDesktopApp</jpackage.app.name>
        <jpackage.launcher.name>AvalonDesktop</jpackage.launcher.name>
        <jpackage.output.dir>${project.build.directory}/jpackage</jpackage.output.dir>
        <jlink.output.dir>${project.build.directory}/jlink</jlink.output.dir>
        <final.app.image.dir>${jpackage.output.dir}/${jpackage.launcher.name}</final.app.image.dir>
        <final.zip.path>${project.build.directory}/${jpackage.app.name}-${project.version}.zip</final.zip.path>
        <app.main.class>org.avalon.desktop.AvalonDesktopApp</app.main.class> <!-- CORREGIDO: Main class -->
        <app.vendor>Avalon Solutions</app.vendor>
        <app.icon>${project.basedir}/src/main/resources/icon.ico</app.icon>

        <!-- Propiedades para resolver errores de símbolos en el IDE -->
        <jpackage.cmd>${java.home}/bin/jpackage</jpackage.cmd>
        <app.jar>${project.build.directory}/${project.build.finalName}.jar</app.jar>
        <libs.dir>${project.build.directory}/libs</libs.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.inject</groupId>
            <artifactId>guice</artifactId>
            <version>${guice.version}</version>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-javafx</artifactId>
            <version>12.3.1</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-materialdesign2-pack</artifactId>
            <version>12.3.1</version>
        </dependency>
        <dependency>
            <groupId>com.fazecast</groupId>
            <artifactId>jSerialComm</artifactId>
            <version>2.10.4</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <!-- Para encriptar contraseñas de forma segura -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>
    </dependencies>


    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>${maven.compiler.source}</release>
                </configuration>
            </plugin>

            <!-- 1. Plugin para jlink (crea la runtime image) -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version> <!-- Versión 0.0.8 como solicitado -->
                <configuration>
                    <mainClass>${app.main.class}</mainClass>
                </configuration>
                <!-- jlink removido de aquí porque no soporta módulos automáticos como Guice -->
            </plugin>

            <!-- 2. Copiar todas las dependencias a target/libs -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${libs.dir}</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- 3. Plugin para ejecutar jpackage y comprimir a ZIP -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version> <!-- Versión reciente de Antrun -->
                <executions>
                    <execution>
                        <id>jpackage-and-zip</id>
                        <phase>package</phase> <!-- Se ejecuta después de 'package', que incluye 'jlink' -->
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- Copiar el JAR principal a la carpeta de libs para que jpackage lo vea -->
                                <copy file="${app.jar}" todir="${libs.dir}" />

                                <!-- Verificar si jpackage existe (para Windows y Unix/Linux/macOS) -->
                                <exec executable="cmd" failonerror="true" osfamily="windows">
                                    <arg value="/c" />
                                    <arg value="if not exist &quot;${jpackage.cmd}.exe&quot; (echo ERROR: jpackage.exe not found at ${jpackage.cmd}.exe. Make sure JDK is installed and in PATH. &amp; exit /b 1)" />
                                </exec>
                                <exec executable="bash" failonerror="true" osfamily="unix">
                                    <arg value="-c" />
                                    <arg value="[ -f &quot;${jpackage.cmd}&quot; ] || { echo ERROR: jpackage not found at ${jpackage.cmd}. Make sure JDK is installed and in PATH.; exit 1; }" />
                                </exec>

                                <!-- Eliminar salida anterior de jpackage -->
                                <delete dir="${jpackage.output.dir}" failonerror="false" />

                                <!-- Ejecutar jpackage -->
                                <echo message="Ejecutando jpackage para crear la imagen de la aplicación portable..." />
                                <exec executable="${jpackage.cmd}" failonerror="true">
                                    <arg value="--input" />
                                    <arg value="${libs.dir}" /> <!-- Ahora apuntamos a la carpeta con todas las JARs -->
                                    <arg value="--main-jar" />
                                    <arg value="${project.build.finalName}.jar" /> <!-- El JAR principal de tu app -->
                                    <arg value="--main-class" />
                                    <arg value="${app.main.class}" />
                                    <arg value="--module-path" />
                                    <arg value="${libs.dir}" /> <!-- Indica a jlink dónde están los módulos de JavaFX -->
                                    <arg value="--add-modules" />
                                    <arg value="javafx.controls,javafx.fxml,javafx.graphics,javafx.base,java.desktop,java.logging,java.net.http,java.sql,java.naming" /> <!-- CORREGIDO: Añadido java.naming -->
                                    <arg value="--type" />
                                    <arg value="app-image" /> <!-- Crea una carpeta portable -->
                                    <arg value="--dest" />
                                    <arg value="${jpackage.output.dir}" /> <!-- Directorio de salida para jpackage -->
                                    <arg value="--name" />
                                    <arg value="${jpackage.launcher.name}" /> <!-- Este será el nombre del .exe y de la carpeta -->
                                    <arg value="--app-version" />
                                    <arg value="${project.version}" />
                                    <arg value="--vendor" />
                                    <arg value="${app.vendor}" />
                                    <arg value="--icon" />
                                    <arg value="${app.icon}" />
                                    <!--<arg value="-win-console" /> Agregamos esto para ver errores -->
                                    <!-- Añade aquí cualquier otro argumento de jpackage que necesites -->
                                </exec>

                                <!-- Comprimir la imagen de la aplicación en un ZIP -->
                                <echo message="Creando archivo ZIP de la aplicación portable..." />
                                <zip destfile="${final.zip.path}" basedir="${final.app.image.dir}" />
                                <echo message="Aplicación portable ZIP creada en: ${final.zip.path}" />
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
